generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String      @id @default(cuid())
  name           String?
  email          String      @unique
  emailVerified  DateTime?
  username       String      @unique
  displayName    String?
  passwordHash   String
  bio            String?
  location       String?
  avatarUrl      String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  profile        Profile?
  sessions       Session[]
  accounts       Account[]
  links          ProfileLink[]
  socialLinks    SocialLink[]
  assets         UploadedAsset[]
  views          ProfileView[]
  clicks         LinkClick[]
  userBadges     UserBadge[]
  reports        Report[]
  subscription   Subscription?
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id])
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?
  user               User    @relation(fields: [userId], references: [id])

  @@unique([provider, providerAccountId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Profile {
  id               String      @id @default(cuid())
  userId           String      @unique
  handle           String      @unique
  profileUrl       String      @unique
  bio              String?
  location         String?
  backgroundType   BackgroundType @default(GRADIENT)
  backgroundValue  String?
  accentColor      String?      @default("#8b5cf6")
  fontFamily       String?      @default("Inter")
  showMusicControls Boolean     @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  user             User         @relation(fields: [userId], references: [id])
  links            ProfileLink[]
  socialLinks      SocialLink[]
  theme            Theme?
  badges           UserBadge[]
}

enum BackgroundType {
  IMAGE
  VIDEO
  GRADIENT
  SOLID
}

model ProfileLink {
  id            String   @id @default(cuid())
  userId        String
  profileId     String
  title         String
  url           String
  icon          String?
  isVisible     Boolean  @default(true)
  isHighlighted Boolean  @default(false)
  clickCount    Int      @default(0)
  order         Int      @default(0)
  startsAt      DateTime?
  endsAt        DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id])
  profile       Profile  @relation(fields: [profileId], references: [id])
  clicks        LinkClick[]
}

model SocialLink {
  id        String   @id @default(cuid())
  userId    String
  profileId String
  platform  String
  url       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
  profile   Profile  @relation(fields: [profileId], references: [id])
}

model UploadedAsset {
  id         String   @id @default(cuid())
  userId     String
  filename   String
  url        String
  type       String
  size       Int
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
}

model ProfileView {
  id         String   @id @default(cuid())
  userId     String
  ipAddress  String?
  userAgent  String?
  referrer   String?
  country    String?
  device     String?
  browser    String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
}

model LinkClick {
  id         String   @id @default(cuid())
  userId     String
  linkId     String
  url        String
  userAgent  String?
  referrer   String?
  country    String?
  device     String?
  browser    String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
  link       ProfileLink @relation(fields: [linkId], references: [id])
}

model Theme {
  id            String   @id @default(cuid())
  profileId     String   @unique
  fontFamily    String?
  accentColor   String?
  borderRadius  String?
  blurAmount    Int?
  glowStrength Int?
  animations    String?
  profile       Profile  @relation(fields: [profileId], references: [id])
}

model Badge {
  id          String   @id @default(cuid())
  label       String
  description String?
  icon        String?
  createdAt   DateTime @default(now())
  userBadges  UserBadge[]
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  profileId String
  assignedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  badge     Badge    @relation(fields: [badgeId], references: [id])
  profile   Profile  @relation(fields: [profileId], references: [id])
}

model Report {
  id         String   @id @default(cuid())
  userId     String
  targetType String
  targetId   String
  reason     String
  status     ReportStatus @default(PENDING)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id])
}

enum ReportStatus {
  PENDING
  REVIEWED
  DISMISSED
}

model Subscription {
  id               String    @id @default(cuid())
  userId           String    @unique
  stripeCustomerId String
  stripePriceId    String
  stripeSubId      String
  status           String
  currentPeriodEnd DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id])
}
